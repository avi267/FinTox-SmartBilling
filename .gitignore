# =============================================================================
# Root-level .gitignore — FinTox-SmartBilling
# =============================================================================

# Virtual environments (venv lives at repo root, not inside the app folder)
venv/
.venv/
env/
.env/

# Python bytecode
__pycache__/
*.py[cod]
*.pyo
*.pyd
.Python

# Distribution / packaging
*.egg-info/
dist/
build/
.eggs/
*.whl

# Environment & secrets
.env
*.env.local
*.env.*.local
fintox_smartbilling_v3/.env

# Streamlit
.streamlit/secrets.toml
fintox_smartbilling_v3/.streamlit/secrets.toml

# Vector / embedding stores (not used now, but guard against accidental add)
chroma_db/
chroma/
.chroma/
faiss_index/
*.faiss
*.pkl

# BM25 / index dumps (in-memory only — no persistence needed)
*.bm25
*.index

# Jupyter
.ipynb_checkpoints/
*.ipynb

# OS
.DS_Store
.DS_Store?
._*
Thumbs.db
ehthumbs.db
desktop.ini

# Claude Code
.claude/settings.local.json
.claude/worktrees/
.claude/scheduled_tasks.json
.claude/plans/
.claude/memory/
.claude/launch.json

# IDE
.vscode/
.idea/
*.swp
*.swo
*~
.project
.classpath

# Test / coverage
.pytest_cache/
.coverage
htmlcov/
*.coveragerc

# Logs
*.log
logs/

# Temporary files
*.tmp
*.bak